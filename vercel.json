{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/account/deactivate", "destination": "/api/grammar-explanation?__lemonRoute=account-deactivate" },
    { "source": "/api/config/public", "destination": "/api/grammar-explanation?__lemonRoute=config-public" },
    { "source": "/api/subscription/status", "destination": "/api/grammar-explanation?__lemonRoute=subscription-status" },
    { "source": "/api/subscription/sync", "destination": "/api/grammar-explanation?__lemonRoute=subscription-sync" },
    { "source": "/api/curriculum/tree", "destination": "/api/grammar-explanation?__lemonRoute=curriculum-tree" },
    { "source": "/api/curriculum/plan", "destination": "/api/grammar-explanation?__lemonRoute=curriculum-plan" },
    { "source": "/api/curriculum/preferences", "destination": "/api/grammar-explanation?__lemonRoute=curriculum-preferences" },
    { "source": "/api/curriculum/progress", "destination": "/api/grammar-explanation?__lemonRoute=curriculum-progress" },
    { "source": "/api/placement/(.*)", "destination": "/api/grammar-explanation?__lemonRoute=placement-$1" },
    { "source": "/api/debug/log", "destination": "/api/grammar-explanation?__lemonRoute=debug-log" },
    { "source": "/api/behavioral-push/open", "destination": "/api/grammar-explanation?__lemonRoute=behavioral-push-open" },
    { "source": "/api/billing/revenuecat/webhook", "destination": "/api/grammar-explanation?__lemonRoute=revenuecat-webhook" },
    { "source": "/api/listening/(.*)", "destination": "/api/listening/[...slug]?slug=$1" },
    { "source": "/api/internal/listening/(.*)", "destination": "/api/internal/listening/[...slug]?slug=$1" },
    { "source": "/api/internal/product-config/(.*)", "destination": "/api/internal/listening/[...slug]?slug=product-config/$1" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "microphone=(self), camera=(), geolocation=(), payment=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.openai.com https://*.openai.com https://*.cognitiveservices.azure.com https://*.api.cognitive.microsoft.com wss://*.stt.speech.microsoft.com wss://*.tts.speech.microsoft.com https://api.revenuecat.com https://*.onesignal.com https://onesignal.com; frame-src 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!api/|assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/internal/listening/audit",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/internal/listening/storage-audit",
      "schedule": "0 8 * * 0"
    },
    {
      "path": "/api/internal/listening/cleanup",
      "schedule": "0 9 * * 0"
    }
  ]
}
