VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Google Sign-In (native Android via @capgo/capacitor-social-login) ────────
# The Google *Web* OAuth client id — NOT the Android client, and NOT a secret
# (OAuth client IDs are public). It is the serverClientId/audience of the native
# id-token flow: SocialLogin.initialize({ google:{ webClientId }}) makes Google
# mint an id token whose `aud` equals this, and this same id must be listed
# under "Authorized Client IDs" in the Supabase Google provider so
# signInWithIdToken accepts it. The WEB sign-in path does NOT read this
# (signInWithOAuth redirects through Supabase, which holds the client secret).
#
# Remote-first note: the Android WebView loads the deployed site, so this must
# be a Vercel env var on the build the app actually runs (Production/Preview) —
# a value here only affects a local `vite build --mode mobile`. Use SEPARATE
# client ids per environment (homolog vs prod). Because it is public it must
# NOT be marked "Sensitive" in Vercel: a Sensitive VITE_ var inlines the literal
# "[SENSITIVE]" into the bundle and breaks native Google login (same failure
# mode as the RevenueCat key incident). Left empty, the Google button simply
# does not appear on native (isGoogleSignInAvailable() → false).
VITE_GOOGLE_WEB_CLIENT_ID=

# ── Sign in with Apple (web gate) ────────────────────────────────────────────
# Set to "true" ONLY after the Supabase Apple provider is fully configured
# (Services ID + client-secret JWT). Until then the web "Continuar com Apple"
# button stays hidden so users never hit a broken flow (isAppleSignInAvailable()).
# This is a public on/off flag, NOT a secret — no Apple key/.p8 ever goes in a
# VITE_ var or the bundle; the Apple client secret lives only in Supabase.
# Native iOS ignores this flag (there the button is gated by the Sign in with
# Apple entitlement via the @capgo plugin). Per environment on Vercel (enable in
# homolog first, prod later); never mark it "Sensitive".
VITE_APPLE_SIGNIN_ENABLED=

# Azure AI Speech — server-side only, never use NEXT_PUBLIC_ or VITE_ prefix
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Server-side only — used to compute deterministic HMAC hashes of
# communication destinations (email/phone/push token) for
# user_communication_blocks.destination_hash. Never use NEXT_PUBLIC_ or
# VITE_ prefix. Generate with e.g. `openssl rand -hex 32`.
COMMUNICATION_SUPPRESSION_HMAC_SECRET=

# ── RevenueCat (iOS + Android native only — see src/lib/revenueCat/) ────────
# Public SDK key for the RevenueCat Apple app — safe to ship in the native
# bundle (RevenueCat's own public-key model, same trust level as an App
# Store Connect shared secret used client-side). VITE_ prefix is correct
# here ONLY because this key is meant to be public; never put a secret
# behind a VITE_/NEXT_PUBLIC_ prefix. Never read on web (src/lib/revenueCat
# never initializes outside a native iOS runtime).
VITE_REVENUECAT_APPLE_API_KEY=

# Public SDK key for the RevenueCat Google Play app — same public-key model
# as above (starts with "goog_"). Read only on native Android. Because the
# app is remote-first (the Android WebView loads the deployed production site,
# not a locally-bundled build), this must be set as a Vercel env var for the
# Production and Preview builds so Vite inlines it into the bundle the app
# actually runs; a value here only affects a local `vite build --mode mobile`.
# If unset, the SDK stays fail-safe: no crash, purchases just unavailable
# (see revenueCatClient.ts's apiKey()).
VITE_REVENUECAT_GOOGLE_API_KEY=

# Server-side only, never VITE_/NEXT_PUBLIC_. Shared secret configured in the
# RevenueCat dashboard's webhook settings (the "Authorization" header
# RevenueCat sends with every webhook delivery) — see
# api/_billing/revenuecat-webhook-verify.ts.
REVENUECAT_WEBHOOK_AUTH_SECRET=

# Server-side only. HMAC-SHA256 signing secret from the RevenueCat webhook's
# optional signature settings — verifies X-RevenueCat-Webhook-Signature
# (format t=<unix_ts>,v1=<hex>) over the raw request body. Leave unset only
# if the RevenueCat project truly has no signing secret configured yet
# (Authorization-header verification still applies either way; see the
# webhook route handler for exactly what "signing not configured" does).
REVENUECAT_WEBHOOK_HMAC_SECRET=

# Server-side only. Used by the authenticated POST /api/subscription/sync
# endpoint to query RevenueCat's REST API for a CustomerInfo lookup by
# app_user_id when a client-initiated resync is requested (e.g. right after
# a purchase, before the webhook has necessarily arrived). Never exposed to
# the client.
REVENUECAT_API_SECRET_KEY=

# ── Operational alerts (server-side only, never VITE_/NEXT_PUBLIC_) ──────────
# E-mails an administrator when an external provider (OpenAI / Azure Speech)
# starts failing in production/homologation. All optional: if RESEND_API_KEY or
# ALERT_RECIPIENT_EMAIL is unset, alerting fails SAFE — it only logs a sanitized
# line and never affects any user request. See api/_ai-gateway/alerts.ts.
#
# Resend API key (https://resend.com). Create with `re_...`.
RESEND_API_KEY=
# Administrator address that receives the alert e-mails. Never hardcoded in code.
ALERT_RECIPIENT_EMAIL=
# From address — must be on a domain verified in Resend. Defaults to
# alerts@orodim.com.br when unset.
ALERT_FROM_EMAIL=
# Authoritative environment label for the alert subject + ai_alerts.environment.
# REQUIRED on the homologation Vercel project: set ALERT_ENVIRONMENT=homolog.
# The homolog project deploys with `vercel deploy --prod`, so it runs with
# VERCEL_ENV='production' too — without this override, homolog alerts would be
# mislabeled [PRODUCTION]. On the real production project set
# ALERT_ENVIRONMENT=production (or leave unset — it defaults to production there
# via VERCEL_ENV). Values: production | homolog.
ALERT_ENVIRONMENT=

# Server-side only, never VITE_. Comma-separated list of Supabase UUIDs
# explicitly allowed to apply SANDBOX (test) purchases on the PRODUCTION
# deployment — Google Play Internal Testing / license testers, whose purchases
# are always is_sandbox=true even though the app runs against the production
# backend. When unset (the default), production blocks every sandbox event
# exactly as before; a UUID here is the ONLY way a sandbox purchase activates a
# plan in production. Matching is case-insensitive. Governs both the webhook and
# POST /api/subscription/sync via one shared policy (revenuecat-environment.ts).
# Example: REVENUECAT_SANDBOX_TEST_USER_IDS=uuid-1,uuid-2
REVENUECAT_SANDBOX_TEST_USER_IDS=
