VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Azure AI Speech — server-side only, never use NEXT_PUBLIC_ or VITE_ prefix
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Server-side only — used to compute deterministic HMAC hashes of
# communication destinations (email/phone/push token) for
# user_communication_blocks.destination_hash. Never use NEXT_PUBLIC_ or
# VITE_ prefix. Generate with e.g. `openssl rand -hex 32`.
COMMUNICATION_SUPPRESSION_HMAC_SECRET=

# ── RevenueCat (iOS + Android native only — see src/lib/revenueCat/) ────────
# Public SDK key for the RevenueCat Apple app — safe to ship in the native
# bundle (RevenueCat's own public-key model, same trust level as an App
# Store Connect shared secret used client-side). VITE_ prefix is correct
# here ONLY because this key is meant to be public; never put a secret
# behind a VITE_/NEXT_PUBLIC_ prefix. Never read on web (src/lib/revenueCat
# never initializes outside a native iOS runtime).
VITE_REVENUECAT_APPLE_API_KEY=

# Public SDK key for the RevenueCat Google Play app — same public-key model
# as above (starts with "goog_"). Read only on native Android. Because the
# app is remote-first (the Android WebView loads the deployed production site,
# not a locally-bundled build), this must be set as a Vercel env var for the
# Production and Preview builds so Vite inlines it into the bundle the app
# actually runs; a value here only affects a local `vite build --mode mobile`.
# If unset, the SDK stays fail-safe: no crash, purchases just unavailable
# (see revenueCatClient.ts's apiKey()).
VITE_REVENUECAT_GOOGLE_API_KEY=

# Server-side only, never VITE_/NEXT_PUBLIC_. Shared secret configured in the
# RevenueCat dashboard's webhook settings (the "Authorization" header
# RevenueCat sends with every webhook delivery) — see
# api/_billing/revenuecat-webhook-verify.ts.
REVENUECAT_WEBHOOK_AUTH_SECRET=

# Server-side only. HMAC-SHA256 signing secret from the RevenueCat webhook's
# optional signature settings — verifies X-RevenueCat-Webhook-Signature
# (format t=<unix_ts>,v1=<hex>) over the raw request body. Leave unset only
# if the RevenueCat project truly has no signing secret configured yet
# (Authorization-header verification still applies either way; see the
# webhook route handler for exactly what "signing not configured" does).
REVENUECAT_WEBHOOK_HMAC_SECRET=

# Server-side only. Used by the authenticated POST /api/subscription/sync
# endpoint to query RevenueCat's REST API for a CustomerInfo lookup by
# app_user_id when a client-initiated resync is requested (e.g. right after
# a purchase, before the webhook has necessarily arrived). Never exposed to
# the client.
REVENUECAT_API_SECRET_KEY=
