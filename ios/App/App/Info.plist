<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Orodim</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Google Sign-In returns the OAuth callback to the app via the iOS OAuth
	     client's REVERSED client id URL scheme. Required for native Google
	     Sign-In to complete. Preserve any other schemes added later (OneSignal,
	     Apple and Capacitor do not need a custom scheme here today). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.159171449078-2fifll286pdvom3r81nqmpph2icmk0st</string>
			</array>
		</dict>
	</array>
	<!-- Google Sign-In native config. GIDClientID = the iOS OAuth client id;
	     GIDServerClientID = the Web client id, so the minted ID token's `aud`
	     matches what the Supabase Google provider accepts. These mirror the
	     values passed to SocialLogin.initialize (src/lib/googleAuth.ts) and let
	     the GoogleSignIn SDK self-configure. -->
	<key>GIDClientID</key>
	<string>159171449078-2fifll286pdvom3r81nqmpph2icmk0st.apps.googleusercontent.com</string>
	<key>GIDServerClientID</key>
	<string>159171449078-d2bp21e2gskg1agfqc82j9evhqjf4fs6.apps.googleusercontent.com</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Required by App Store validation (warning ITMS-90683): the OneSignal
	     push SDK links CoreLocation via its OneSignalLocation module (pulled by
	     @onesignal/capacitor-plugin unless ONESIGNAL_DISABLE_LOCATION is set at
	     Xcode SPM resolution time). Orodim never calls the location API, so this
	     prompt is not shown to users; the string exists only to satisfy Apple's
	     purpose-string requirement for the symbol present in the binary. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>O Orodim pode usar sua localização aproximada para tornar as notificações e recomendações de estudo mais relevantes. O app funciona normalmente sem esse acesso.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>O Orodim usa o microfone para gravar sua pronúncia e suas conversas em inglês durante as atividades de prática.</string>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Required for OneSignal confirmed delivery / content-available
		     (background) push handling. Only this mode is enabled. -->
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
