<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug entitlements: development APNs environment. The Release config
	     points at AppRelease.entitlements (aps-environment = production).
	     Both must declare the SAME App Group as the Notification Service
	     Extension so OneSignal confirmed-delivery/badges can share state. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.lemonenglish.lemon.onesignal</string>
	</array>
</dict>
</plist>
